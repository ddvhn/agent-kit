# Copy to fastlane/.env (git-ignored) and fill in. Never commit real values.
# Keys live in fastlane/keys/ (git-ignored); CI passes the *_BASE64 / *_DATA
# variants from its secret store instead of files.

# App Store Connect API key (Users and Access → Integrations, role App Manager).
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=fastlane/keys/AuthKey.p8
# CI: base64 of the .p8 instead of the path.
# APP_STORE_CONNECT_API_KEY_KEY_BASE64=

# Google Play service account JSON (Play Console → Users and permissions,
# release to testing tracks for the app).
SUPPLY_JSON_KEY=fastlane/keys/play-service-account.json
# CI: the JSON content instead of the path.
# SUPPLY_JSON_KEY_DATA=

# Android upload keystore. Locally android/key.properties is enough; CI writes
# a temporary one from these.
# ANDROID_KEYSTORE_BASE64=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=

# Apple team id that signs the iOS builds.
IOS_TEAM_ID=

# Play release status: draft until the app's first release is published
# by hand in Play Console, then completed.
PLAY_RELEASE_STATUS=draft

# Optional: TestFlight internal groups for dev and staging (comma separated).
# TESTFLIGHT_GROUPS=
# Optional: release notes language of the Play listing (en-US).
# PLAY_RELEASE_NOTES_LANGUAGE=
# Optional: the git remote the lanes check and push tags to (default origin).
# GIT_REMOTE=origin

# Optional: Firebase App Distribution (the commented firebase_dev lane).
# FIREBASE_TOKEN is deprecated; use a service account.
# FIREBASE_APP_DISTRIBUTION_CREDENTIALS_FILE=fastlane/keys/firebase-distribution.json
# FIREBASE_APP_ID_ANDROID_DEV=
# FIREBASE_APP_ID_IOS_DEV=
# FIREBASE_TESTER_GROUPS=
